<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup and phone-to-phone transfer on Android 12+.
  cloud-backup: only when the backup is end-to-end encrypted with the phone's screen lock
  (disableIfNoEncryptionCapabilities), so nobody else, not even Google, can read it.
  device-transfer: a direct copy to the user's new phone during setup.
  The automatic safety copies are excluded on purpose: their encryption key is bound to this phone.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="database" path="hanita_database" />
        <include domain="database" path="hanita_database-wal" />
        <include domain="database" path="hanita_database-shm" />
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="crash_reports.xml" />
        <exclude domain="sharedpref" path="hanita_snapshots.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="hanita_database" />
        <include domain="database" path="hanita_database-wal" />
        <include domain="database" path="hanita_database-shm" />
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="crash_reports.xml" />
        <exclude domain="sharedpref" path="hanita_snapshots.xml" />
    </device-transfer>
</data-extraction-rules>
