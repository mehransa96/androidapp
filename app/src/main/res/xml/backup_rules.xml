<?xml version="1.0" encoding="utf-8"?>
<!--
  Android Auto Backup on Android 6–11 (Android 12+ uses data_extraction_rules.xml).
  Only the user's own data is backed up so it survives a reinstall or a new phone:
  the Hanita database and the settings/account. requireFlags="clientSideEncryption" (Android 9+)
  means it goes to the user's Google backup ONLY when that backup is end-to-end encrypted with the
  phone's screen lock, so not even Google can read it.
  Not backed up: the automatic safety copies (their key never leaves this phone), crash info,
  WorkManager's internal database.
-->
<full-backup-content>
    <include domain="database" path="hanita_database" requireFlags="clientSideEncryption" />
    <include domain="database" path="hanita_database-wal" requireFlags="clientSideEncryption" />
    <include domain="database" path="hanita_database-shm" requireFlags="clientSideEncryption" />
    <include domain="sharedpref" path="." requireFlags="clientSideEncryption" />
    <exclude domain="sharedpref" path="crash_reports.xml" />
    <exclude domain="sharedpref" path="hanita_snapshots.xml" />
</full-backup-content>
